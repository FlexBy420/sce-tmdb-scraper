    },
    {
      "trophyGroupId": "002",
      "trophyGroupName": "Обнаженный город",
      "trophyGroupDetail": "Джулия Рэндалл, известная молодая модель, найдена утонувшей в собственной ванне. Для отдела убийств это дело выглядит как эталонное самоубийство, но коронер Малькольм Карразерс сомневается в этом. Детективам Фелпсу и Эрлу поручено установить, какой из множества пороков мисс Рэндалл смог её убить.",
      "trophyGroupIconUrl": "https://image.api.playstation.com/trophy/np/NPWR13863_00_0047C9BE2B69211FD6C2C09C88B990EDF7FCF2007A/774600EB46B66801809147D58160601772226B2B.PNG",
