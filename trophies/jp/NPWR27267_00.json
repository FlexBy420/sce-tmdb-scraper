  "trophies": [
    {
      "trophyId": 0,
      "trophyHidden": false,
      "trophyType": "platinum",
      "trophyName": "ポゴレンを生き抜け",
      "trophyDetail": "すべてのトロフィーを取得する",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/9c6a978e-3d7e-4588-b21e-8d00974ac46e.png",
      "trophyGroupId": "default"
    },
    {
      "trophyId": 1,
      "trophyHidden": true,
      "trophyType": "gold",
      "trophyName": "エピローグ：戦争終結",
      "trophyDetail": "戦火はあらゆる場所で荒れ狂い、そしてあまりにも長く続いた。多くの人にとっては限界を超えた長さだったろうが、私は生き延びた。生き延びたのが、私だけでなければいいが。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/63ee7a81-58d1-4eec-9add-7b0e0befc521.png",
      "trophyGroupId": "default"
    },
    {
      "trophyId": 2,
      "trophyHidden": true,
      "trophyType": "bronze",
      "trophyName": "日記：７日目",
      "trophyDetail": "ここに隠れて７日経った。死は、ありふれたものとなっているが、私たちは幸運にも全員生き延びている――今のところは……。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/25d8783a-47bb-4f57-9c9e-1a4e31eb4a61.png",
      "trophyGroupId": "default"
    },
    {
      "trophyId": 3,
      "trophyHidden": true,
      "trophyType": "silver",
      "trophyName": "日記：ひどい大雪",
      "trophyDetail": "忌々しい雪だ。雪が町の半分を埋め尽くし、身動きが取れなくなってしまった。除雪機が来るのを待っても意味がない……。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/e366b1d5-dd1f-4d44-b94e-2413605a2317.png",
      "trophyGroupId": "default"
    },
    {
      "trophyId": 4,
      "trophyHidden": true,
      "trophyType": "bronze",
      "trophyName": "日記：探し回るのは終わり",
      "trophyDetail": "私たちは住み家の隅々まで探り尽くした。役に立つものはもう何も見つからないだろう。思い切って外に出なければならない。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/7989b02f-5f28-4a6a-919c-8f0f40ec8481.png",
      "trophyGroupId": "default"
    },
    {
      "trophyId": 5,
      "trophyHidden": true,
      "trophyType": "bronze",
      "trophyName": "ノート：ラジオに祝福あれ",
      "trophyDetail": "ラジオは思っていた以上に便利だ。ニュースを聞くことができるし、普通の生活や広い世界のことを思い出せるのは、本当に最高だ。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/4a90fa6c-cc86-4919-9c51-1e7b78fd52bb.png",
      "trophyGroupId": "default"
    },
    {
      "trophyId": 6,
      "trophyHidden": true,
      "trophyType": "bronze",
      "trophyName": "ノート：黄金の蒸留",
      "trophyDetail": "ようやく密造酒の醸造に成功した。包囲された町では、食物とアルコールが常に大人気だ。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/0a84602d-900d-4f9b-afc7-5d8d8f85123a.png",
      "trophyGroupId": "default"
    },
    {
      "trophyId": 7,
      "trophyHidden": true,
      "trophyType": "bronze",
      "trophyName": "ノート：二重の見張り",
      "trophyDetail": "私たちの居場所を夜間の侵入者から守るのは重要なことだ。二人の人間が盗人を見張っていれば、お互いに監視し合うこともできる。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/47b751c2-8125-41c3-83b9-7a7adf853c2c.png",
      "trophyGroupId": "default"
    },
    {
      "trophyId": 8,
      "trophyHidden": true,
      "trophyType": "gold",
      "trophyName": "日記：奇跡の回復",
      "trophyDetail": "重病からこうも回復するとは、投与したのは奇跡を起こす薬だったようだ。あるいは、ことによると、免疫系が本当にタフな人もいるということだろう。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/a5c4ad57-5955-4782-a532-09443278da11.png",
      "trophyGroupId": "default"
    },
    {
      "trophyId": 9,
      "trophyHidden": true,
      "trophyType": "gold",
      "trophyName": "日記：応急処置で準備万端",
      "trophyDetail": "なんて幸運なんだろう。重いけがの手当てに成功しただけじゃなく、その後の経過も順調だ。誰かが私たちのために祈ってくれているに違いない。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/cbf1fe94-8d54-4420-be5a-a0b1662ef335.png",
      "trophyGroupId": "default"
    },
    {
      "trophyId": 10,
      "trophyHidden": true,
      "trophyType": "gold",
      "trophyName": "日記：ドン底からの復活",
      "trophyDetail": "完全なる絶望は、銃弾と同様に人を死に至らしめることができる。私たちは親身な言葉と行動により、絶望の淵にあった仲間の命を救った。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/59a1637c-db2c-436b-ae42-5f7deb027b03.png",
      "trophyGroupId": "default"
    },
    {
      "trophyId": 11,
      "trophyHidden": true,
      "trophyType": "bronze",
      "trophyName": "日記：ホステル開業！",
      "trophyDetail": "今や全員分のベッドが揃った――つまり、外に出て、物資を探さなきゃいけない人以外の、全員の分だ。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/015ea882-9df4-4d7d-9bfb-9fc3c5a39e8a.png",
      "trophyGroupId": "default"
    },
    {
      "trophyId": 12,
      "trophyHidden": true,
      "trophyType": "bronze",
      "trophyName": "日記：目指せ五つ星",
      "trophyDetail": "ここにたどり着いて以来、初めて、私たち全員が温かい食事を口にした。まだこれには慣れないようにしよう。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/880c2469-f1c2-4c46-a5bf-7b4e718782d6.png",
      "trophyGroupId": "default"
    },
    {
      "trophyId": 13,
      "trophyHidden": true,
      "trophyType": "gold",
      "trophyName": "日記：初めての戦闘",
      "trophyDetail": "仲間の一人が初めて殺されかけ、そして生き延びた。望みは薄いが、こんなことはもうないことを切に願う。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/a101846b-fa2d-4009-abae-62323828345f.png",
      "trophyGroupId": "default"
    },
    {
      "trophyId": 14,
      "trophyHidden": true,
      "trophyType": "silver",
      "trophyName": "ノート：快適な生活",
      "trophyDetail": "私たちの居場所はちゃんとした家のようになりつつある。家具を備え付けてさらに快適に生活できるようにすれば、皆の士気を維持できるだろう。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/b6c2979b-f094-4be8-bfdf-72bc1e0781da.png",
      "trophyGroupId": "default"
    },
    {
      "trophyId": 15,
      "trophyHidden": true,
      "trophyType": "silver",
      "trophyName": "日記：生活の跡",
      "trophyDetail": "訪れるすべての建物には語られるべき物語がある。ときに思う。私たちはどんな物語を後に残すのだろうか……。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/a1b29277-3368-4068-ab7b-50db33ed4c75.png",
      "trophyGroupId": "default"
    },
    {
      "trophyId": 16,
      "trophyHidden": true,
      "trophyType": "bronze",
      "trophyName": "日記：冬を越えた",
      "trophyDetail": "冬は去った。凍えるような寒さはもう終わりだ。私たちは生き延びた……それも全員がだ！素晴らしい。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/1e228f14-2572-4476-9ab6-ee28fd7bd662.png",
      "trophyGroupId": "default"
    },
    {
      "trophyId": 17,
      "trophyHidden": true,
      "trophyType": "gold",
      "trophyName": "エピローグ：生き延びた！",
      "trophyDetail": "最初は、私たち全員が生き延びられるなんて思いもしなかった。あまりにも多くの人が戦争で命を落としたが、私たちはまだ生きている。私たちは間違いなく、すごいことをやってのけたんだ……そうだろう？\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/a213511a-67f8-479d-9a61-bbee2192ba2b.png",
      "trophyGroupId": "default"
    },
    {
      "trophyId": 18,
      "trophyHidden": true,
      "trophyType": "silver",
      "trophyName": "日記：あらゆる場所を訪れた",
      "trophyDetail": "隣近所をくまなく探しているが、役に立つ物を見つけるのが段々と困難になってきている。この戦争が終わるまで持つとは思えない。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/ec6f2565-7c0d-430b-adc6-c4e34651bd9d.png",
      "trophyGroupId": "default"
    },
    {
      "trophyId": 19,
      "trophyHidden": true,
      "trophyType": "silver",
      "trophyName": "日記：持ちこたえた",
      "trophyDetail": "強盗が、飢えた犬のように集団でやって来た。私たちは、毎晩奴らを撃退した。そして、全員が生き延びた。奇跡だ。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/f2fd1623-20e7-4a6d-927a-a6893d5ee029.png",
      "trophyGroupId": "default"
    },
    {
      "trophyId": 20,
      "trophyHidden": true,
      "trophyType": "bronze",
      "trophyName": "ノート：つかの間の耽溺",
      "trophyDetail": "初めて、全員分の嗜好品を用意できた。これでやる気が出るというものだ。今夜には死ぬかもしれないのに、健康上の問題なんて気にしていられるか。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/446ea75b-4a51-4d85-9dd8-cb266d0f0751.png",
      "trophyGroupId": "default"
    },
    {
      "trophyId": 21,
      "trophyHidden": true,
      "trophyType": "gold",
      "trophyName": "エピローグ：エクソダス",
      "trophyDetail": "ようやく安全な場所に行ける。私は振り返り、燃え盛る町を見て涙を流した。望む者全員が、ポゴレンから脱出できれば良かったのに。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/9b78c943-857f-4210-89a7-04bd2a54e454.png",
      "trophyGroupId": "default"
    },
    {
      "trophyId": 22,
      "trophyHidden": true,
      "trophyType": "gold",
      "trophyName": "エピローグ：新しい命",
      "trophyDetail": "リヴィアは終戦まで生き延び、平和な時代に新しい命を授かった。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/631e456e-fef1-45ec-8763-dc3f041239f4.png",
      "trophyGroupId": "default"
    },
    {
      "trophyId": 23,
      "trophyHidden": true,
      "trophyType": "silver",
      "trophyName": "日記：真実",
      "trophyDetail": "自らと向き合い、あの恐ろしい夜の真実を知った。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/1709b170-7e66-4ebd-85ea-400efc28fa27.png",
      "trophyGroupId": "001"
    },
    {
      "trophyId": 24,
      "trophyHidden": true,
      "trophyType": "bronze",
      "trophyName": "日記：砲撃されても我が家は我が家",
      "trophyDetail": "ようやく住み慣れたアパートに帰れるようになった。あるいは、住み慣れたアパートの残骸に。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/af0b1a72-e909-4285-bbb7-01351f464148.png",
      "trophyGroupId": "001"
    },
    {
      "trophyId": 25,
      "trophyHidden": true,
      "trophyType": "bronze",
      "trophyName": "日記：思いやり",
      "trophyDetail": "パーカーは、アメリアにとって何よりも大切なものだった。しかし、戦争がすべてを変えてしまった。あのボロボロの服は、この女性の健康、おそらく生命にとって、欠かせないものになっていたのだ。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/fc4805d9-6991-46aa-9efa-731cd09ccf40.png",
      "trophyGroupId": "001"
    },
    {
      "trophyId": 26,
      "trophyHidden": true,
      "trophyType": "bronze",
      "trophyName": "日記：医者",
      "trophyDetail": "リスクは高かったが、じっとしてはいられなかった。私は兵士たちを殺し、医者を救った。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/d943eb79-2393-4677-acc9-0f2bd4f5942d.png",
      "trophyGroupId": "001"
    },
    {
      "trophyId": 27,
      "trophyHidden": true,
      "trophyType": "bronze",
      "trophyName": "日記：良き隣人",
      "trophyDetail": "辛い冬だった。ティトーが父をたびたび助けてくれていたのを知っていた私は、彼を助けることに決めた。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/0c0fc213-0671-47f9-ae20-7c6e0706ef07.png",
      "trophyGroupId": "002"
    },
    {
      "trophyId": 28,
      "trophyHidden": true,
      "trophyType": "gold",
      "trophyName": "エピローグ：完遂",
      "trophyDetail": "すべての他のエンディングでゲームをクリアする。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/d1f5b724-537a-4a28-8fe8-78d1e7a5d4d2.png",
      "trophyGroupId": "002"
    },
    {
      "trophyId": 29,
      "trophyHidden": true,
      "trophyType": "bronze",
      "trophyName": "日記：管理人",
      "trophyDetail": "ゾランの使命は果たされた。私たちは、一つの文化遺産も焼かなかった。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/0858d667-063c-4d83-964a-2eceebb4e39f.png",
      "trophyGroupId": "002"
    },
    {
      "trophyId": 30,
      "trophyHidden": true,
      "trophyType": "bronze",
      "trophyName": "ノート：補強",
      "trophyDetail": "この建物は爆撃で損傷している。少しでも長く時間を稼ぐために、すべての柱を補強することに決めた。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/4fcee459-7dbc-4734-ab32-f082185dcda9.png",
      "trophyGroupId": "002"
    },
    {
      "trophyId": 31,
      "trophyHidden": true,
      "trophyType": "bronze",
      "trophyName": "ノート：すべてを焼き払え",
      "trophyDetail": "火に包まれた世界を見たくてしょうがない人もいる。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/1b23614d-6746-47b7-9ae6-495a97798ee0.png",
      "trophyGroupId": "002"
    },
    {
      "trophyId": 32,
      "trophyHidden": true,
      "trophyType": "bronze",
      "trophyName": "日記：無垢な子供たち",
      "trophyDetail": "子供たちには養父のアダムしかいなかった。今や子供たちには、この戦争を生き延びることへのかすかな希望の光がある。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/dc1bf1eb-e444-474b-b85e-c739487bc736.png",
      "trophyGroupId": "002"
    },
    {
      "trophyId": 33,
      "trophyHidden": true,
      "trophyType": "bronze",
      "trophyName": "ノート：トラックの準備完了",
      "trophyDetail": "私たちはついにトラックの修理に成功した。これで文化遺産を安全に運べる。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/569b518f-4f2e-47b8-9a40-66d153a98de6.png",
      "trophyGroupId": "002"
    },
    {
      "trophyId": 34,
      "trophyHidden": true,
      "trophyType": "bronze",
      "trophyName": "ノート：大佐",
      "trophyDetail": "マルコフ大佐に絵画を渡した。私たちの文化遺産はこれでもう安全なはずだ。\n",
      "trophyIconUrl": "https://psnobj.prod.dl.playstation.net/psnobj/NPWR27267_00/0569ddec-a87e-485c-b209-c4bfc2852df3.png",
      "trophyGroupId": "002"
    },
    {
      "trophyId": 35,
      "trophyHidden": true,
      "trophyType": "bronze",
      "trophyName": "ノート：フェンス",
