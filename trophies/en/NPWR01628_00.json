      }
    },
    {
      "trophyGroupId": "004",
      "trophyGroupName": "Dragon Age: Origins - Leliana's Song",
      "trophyGroupDetail": "Assume the role of Leliana, a young bard involved in a criminal ring that deals in political secrets. Accompanying her mentor Marjolaine on a high-risk mission, Leliana soon finds herself entangled in a game of intrigue that she cannot escape with just her beauty, charm, or stealth.  The only way out of this game is to kill or be killed.",
      "trophyGroupIconUrl": "https://image.api.playstation.com/trophy/np/NPWR01628_00_00D4B04299D5B4DBC016D9AA102BCE736D57ECF275/C9FF06097797CA7C713E0615F388EEB306809AC2.PNG",
