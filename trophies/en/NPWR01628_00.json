        "platinum": 0
      }
    },
    {
      "trophyGroupId": "003",
      "trophyGroupName": "Dragon Age: Origins - Return to Ostagar",
      "trophyGroupDetail": "Your memories of the battle of Ostagar will haunt you for years to come. It laid waste to your order and claimed the lives of many great men and women, including the brash young King Cailan and your mentor, Duncan. The time has come for the Grey Wardens to make their return to Ostagar and exact their revenge upon the darkspawn.",
      "trophyGroupIconUrl": "https://image.api.playstation.com/trophy/np/NPWR01628_00_00D4B04299D5B4DBC016D9AA102BCE736D57ECF275/71259BC803B11B5EFDE7BFF741203ED8AE60E3EA.PNG",
      "definedTrophies": {
