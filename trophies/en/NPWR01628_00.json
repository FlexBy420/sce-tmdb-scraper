    {
      "trophyGroupId": "006",
      "trophyGroupName": "Dragon Age: Origins - Awakening",
      "trophyGroupDetail": "The archdemon lies dead--and yet in coastal Amaranthine, strange darkspawn still plague the land. As the newly appointed commander of the Grey Wardens, you must rebuild your shattered stronghold, recruit new Wardens to the cause, and defeat this terrifying menace.",
      "trophyGroupIconUrl": "https://image.api.playstation.com/trophy/np/NPWR01628_00_00D4B04299D5B4DBC016D9AA102BCE736D57ECF275/8AA5FD8E79663E46A13B08994C54D2A6208CCA54.PNG",
