      }
    },
    {
      "trophyGroupId": "005",
      "trophyGroupName": "Dragon Age: Origins - The Golems of Amgarrak",
      "trophyGroupDetail": "The dwarves' lost thaigs, forgotten for a thousand years, are finally within reach. Among them is Amgarrak, once home to scholars intent on rediscovering Caridin's art of golemcraft. But an expedition to the ruins has gone missing. Only you can uncover the gruesome fate that befell them.",
      "trophyGroupIconUrl": "https://image.api.playstation.com/trophy/np/NPWR01628_00_00D4B04299D5B4DBC016D9AA102BCE736D57ECF275/BF050B6F05DC8B30FF44D42D974768CCF6B906E0.PNG",
