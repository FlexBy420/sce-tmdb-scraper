      }
    },
    {
      "trophyGroupId": "002",
      "trophyGroupName": "La ciudad desnuda",
      "trophyGroupDetail": "Julia Randall, una joven modelo de mucho éxito, aparece muerta en la bañera. Para la Brigada de Homicidios, parece un suicidio de manual: una vida glamurosa con un final trágico. Sin embargo, el forense Malcom Carruthers no lo tiene tan claro. Los detectives Phelps y Earle deberán investigar el escenario del crimen y descubrir cuál de los múltiples vicios de la señorita Randall ha acabado con ella.",
      "trophyGroupIconUrl": "https://image.api.playstation.com/trophy/np/NPWR13863_00_0047C9BE2B69211FD6C2C09C88B990EDF7FCF2007A/774600EB46B66801809147D58160601772226B2B.PNG",
