<?xml version="1.0" encoding="utf-8"?>
<Root>
  <message type="OneShot" repeatCnt="2">
    <source id="2711" unique_name="GAF Welcome Message" is_remote_fed="false" seq="12" should_be_translated="True" is_redundant="false">
      <text modified="2014-08-26 10:59:54" xml:space="preserve">Welcome to Hustle Kings.   Start with the Training Mode before jumping into the League if you want the best chance of success.</text>
      <flags>
        <flag edit="false" name="Ready to Translate" type="select" icon="ready_to_translate.png" dirty="False" active="true" user="NMcPhillips" date="2014-08-27 07:10:48" xml:space="preserve">Yes</flag>
      </flags>
    </source>
    <translations>
      <translation id="2711" lang="da">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="danQA1" date="2014-08-27 15:56:35" />
        </flags>
        <text modified="2014-08-27 15:56:30" textChanged="2014-08-27 15:56:30" updated="2014-08-27 15:56:30" touched="2014-08-27 15:56:35" out_of_date="False" xml:space="preserve">Velkommen til Hustle Kings. Start med nogle træningsspil, før du prøver kræfter med ligaen, hvis du vil have den bedste chance for succes.</text>
        <subtitles />
      </translation>
      <translation id="2711" lang="de">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="gerQA2" date="2014-08-27 14:39:22" />
        </flags>
        <text modified="2014-08-27 08:01:19" textChanged="2014-08-27 12:55:50" updated="2014-08-27 12:55:50" touched="2014-08-27 12:55:50" out_of_date="False" xml:space="preserve">Willkommen bei Hustle Kings. Wenn Sie sich Ihre Aussichten auf Erfolg bewahren wollen, sollten Sie mit dem Trainingsmodus beginnen und nicht direkt in die Liga eintauchen.</text>
        <subtitles />
      </translation>
      <translation id="2711" lang="en">
        <flags />
        <text modified="2014-08-26 10:59:55" textChanged="2014-08-26 10:59:55" updated="2014-08-26 10:59:55" touched="2014-08-27 07:10:48" out_of_date="False" xml:space="preserve">Welcome to Hustle Kings.   Start with the Training Mode before jumping into the League if you want the best chance of success.</text>
        <subtitles />
      </translation>
      <translation id="2711" lang="es">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="spaQA1" date="2014-08-27 15:09:08" />
        </flags>
        <text modified="2014-08-27 08:01:22" textChanged="2014-08-27 11:25:07" updated="2014-08-27 11:25:07" touched="2014-08-27 11:25:07" out_of_date="False" xml:space="preserve">Bienvenidos a Hustle Kings. Si quieres tener más probabilidades de éxito, empieza con el Modo de entrenamiento antes de pasar a la Liga.</text>
        <subtitles />
      </translation>
      <translation id="2711" lang="fi">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="finQA1" date="2014-08-28 11:08:01" />
        </flags>
        <text modified="2014-08-27 08:01:18" textChanged="2014-08-27 14:14:11" updated="2014-08-27 14:14:11" touched="2014-08-27 14:14:11" out_of_date="False" xml:space="preserve">Tervetuloa Hustle Kings -peliin.   Aloita harjoittelemalla ennen kuin osallistut liigaan, jos haluat mahdollisuuden menestyä.</text>
        <subtitles />
      </translation>
      <translation id="2711" lang="fr">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="freQA1" date="2014-08-27 15:27:44" />
        </flags>
        <text modified="2014-08-27 08:01:19" textChanged="2014-08-27 10:47:54" updated="2014-08-27 10:47:54" touched="2014-08-27 10:47:54" out_of_date="False" xml:space="preserve">Bienvenue dans Hustle Kings. Commencez par le mode Entraînement avant de vous lancer dans la ligue si vous voulez augmenter vos chances de succès.</text>
        <subtitles />
      </translation>
      <translation id="2711" lang="it">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="itaQA1" date="2014-08-27 14:47:43" />
        </flags>
        <text modified="2014-08-27 08:01:20" textChanged="2014-08-27 11:08:03" updated="2014-08-27 11:08:03" touched="2014-08-27 11:08:03" out_of_date="False" xml:space="preserve">Benvenuto in Hustle Kings. Inizia dalla modalità Allenamento, prima di affrontare il Campionato, se vuoi avere più possibilità di vincere.</text>
        <subtitles />
      </translation>
      <translation id="2711" lang="jp">
        <flags />
        <text modified="2014-08-29 14:59:20" textChanged="2014-08-29 15:03:48" updated="2014-08-29 15:03:48" touched="2014-08-29 15:03:48" out_of_date="True" xml:space="preserve"></text>
        <subtitles />
      </translation>
      <translation id="2711" lang="nl">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="dutQA1" date="2014-08-28 10:46:31" />
        </flags>
        <text modified="2014-08-28 10:46:30" textChanged="2014-08-28 10:46:30" updated="2014-08-28 10:46:30" touched="2014-08-28 10:46:30" out_of_date="False" xml:space="preserve">Welkom bij Hustle Kings. Vergroot je kans op succes door te beginnen met het speltype Training voor je je op het klassement stort.</text>
        <subtitles />
      </translation>
      <translation id="2711" lang="no">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="norQA1" date="2014-08-27 14:52:10" />
        </flags>
        <text modified="2014-08-27 08:01:20" textChanged="2014-08-27 14:14:22" updated="2014-08-27 14:14:22" touched="2014-08-27 14:14:22" out_of_date="False" xml:space="preserve">Velkommen til Hustle Kings. Start med treningsmodus før du tar steget inn i ligaen – det vil gjøre deg best mulig rustet til å lykkes.</text>
        <subtitles />
      </translation>
      <translation id="2711" lang="po">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="polQA1" date="2014-08-27 14:39:43" />
        </flags>
        <text modified="2014-08-27 08:01:20" textChanged="2014-08-27 12:54:35" updated="2014-08-27 12:54:35" touched="2014-08-27 12:54:35" out_of_date="False" xml:space="preserve">Witamy w Hustle Kings. Jeśli chcesz osiągnąć jak najlepsze rezultaty, rozpocznij od Trybu Szkolenia, a następnie przejdź do Ligi.</text>
        <subtitles />
      </translation>
      <translation id="2711" lang="pt">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="porQA2" date="2014-08-28 11:41:04" />
        </flags>
        <text modified="2014-08-28 11:41:01" textChanged="2014-08-28 11:41:01" updated="2014-08-28 11:41:01" touched="2014-08-28 11:41:01" out_of_date="False" xml:space="preserve">Olá, este é o Hustle Kings! Para melhorares as tuas hipóteses, é melhor começar no Modo de Treino antes de tentares a Liga.</text>
        <subtitles />
      </translation>
      <translation id="2711" lang="ru">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="rusQA1" date="2014-08-28 10:39:30" />
        </flags>
        <text modified="2014-08-27 08:01:21" textChanged="2014-08-28 07:19:47" updated="2014-08-28 07:19:47" touched="2014-08-28 07:19:47" out_of_date="False" xml:space="preserve">Добро пожаловать в игру Hustle Kings. Чтобы повысить свои шансы на успех, начните с тренировочного режима, а уж затем переходите к игре в лиге.</text>
        <subtitles />
      </translation>
      <translation id="2711" lang="sv">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="sweQA1" date="2014-08-27 14:36:52" />
        </flags>
        <text modified="2014-08-27 08:01:22" textChanged="2014-08-27 14:14:45" updated="2014-08-27 14:14:45" touched="2014-08-27 14:14:45" out_of_date="False" xml:space="preserve">Välkommen till Hustle Kings. Börja med träningsläget innan du ger dig in i ligan om du vill ha högst chans att lyckas.</text>
        <subtitles />
      </translation>
      <translation id="2711" lang="bpt">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="braQA2" date="2014-09-11 13:01:28" />
        </flags>
        <text modified="2014-08-28 08:29:41" textChanged="2014-09-09 11:33:13" updated="2014-09-09 11:33:13" touched="2014-09-09 11:33:13" out_of_date="False" xml:space="preserve">Bem-vindo a Hustle Kings. Comece com o modo de treinamento antes de participar da Liga, se você quiser melhorar suas chances de sucesso.</text>
        <subtitles />
      </translation>
      <translation id="2711" lang="las">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="mexQA2" date="2014-09-10 15:22:36" />
        </flags>
        <text modified="2014-08-28 08:29:48" textChanged="2014-09-09 11:34:08" updated="2014-09-09 11:34:08" touched="2014-09-09 11:34:08" out_of_date="False" xml:space="preserve">Bienvenido a Hustle Kings. Si quieres tener más probabilidades de éxito, empieza con el modo Entrenamiento antes de pasar a la Liga.</text>
        <subtitles />
      </translation>
    </translations>
  </message>
  <message type="BGCycling" repeatCnt="1">
    <source id="2962" unique_name="Why not spend your HKC on a new Cue to make sure you stand out from the rest of the crowd when playing online!" is_remote_fed="false" seq="32" should_be_translated="True" is_redundant="false">
      <text modified="2015-04-10 17:56:24" xml:space="preserve">Why not purchase a new cue with your HKC to help stand out from the crowd online!</text>
      <flags />
    </source>
    <links />
    <translations>
      <translation id="2962" lang="ae">
        <flags />
        <text modified="2015-04-13 17:17:22" textChanged="2015-04-13 17:17:22" updated="2015-04-13 17:17:22" touched="2015-04-13 17:17:22" out_of_date="False" xml:space="preserve">Why not purchase a new cue with your HKC to help stand out from the crowd online!</text>
        <subtitles />
      </translation>
      <translation id="2962" lang="da">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="danQA1" date="2015-04-14 10:23:30" />
        </flags>
        <text modified="2015-04-14 10:23:28" textChanged="2015-04-13 15:09:59" updated="2015-04-14 10:23:28" touched="2015-04-14 10:23:28" out_of_date="False" xml:space="preserve">Hvorfor ikke købe en ny kø med dine HKC, så du kan skille dig lidt ud online?</text>
        <subtitles />
      </translation>
      <translation id="2962" lang="de">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="gerQA2" date="2015-04-14 10:27:32" />
        </flags>
        <text modified="2015-04-14 10:27:22" textChanged="2015-04-13 15:10:16" updated="2015-04-14 10:27:22" touched="2015-04-14 10:27:22" out_of_date="False" xml:space="preserve">Kaufen Sie mit Ihren HKC einen neuen Queue, um sich online von anderen Spielern abzuheben!</text>
        <subtitles />
      </translation>
      <translation id="2962" lang="en">
        <flags />
        <text modified="2015-04-10 17:56:24" textChanged="2015-04-10 17:56:24" updated="2015-04-10 17:56:24" touched="2015-04-10 17:56:24" out_of_date="False" xml:space="preserve">Why not purchase a new cue with your HKC to help stand out from the crowd online!</text>
        <subtitles />
      </translation>
      <translation id="2962" lang="es">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="spaQA1" date="2015-04-14 10:08:30" />
        </flags>
        <text modified="2015-04-14 10:08:28" textChanged="2015-04-13 15:12:02" updated="2015-04-14 10:08:28" touched="2015-04-14 10:08:28" out_of_date="False" xml:space="preserve">¡Por qué no compras un nuevo taco con tus CHK para que te ayude a destacar entre la multitud en línea!</text>
        <subtitles />
      </translation>
      <translation id="2962" lang="fi">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="finQA1" date="2015-04-14 10:17:57" />
        </flags>
        <text modified="2015-04-14 10:17:55" textChanged="2015-04-13 15:10:24" updated="2015-04-14 10:17:55" touched="2015-04-14 10:17:55" out_of_date="False" xml:space="preserve">Miksi et ostaisi uutta köötä HKC-varoillasi, niin erotut joukosta verkkopeleissä!</text>
        <subtitles />
      </translation>
      <translation id="2962" lang="fr">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="freQA1" date="2015-04-14 09:58:27" />
        </flags>
        <text modified="2015-04-14 09:58:24" textChanged="2015-04-13 15:11:07" updated="2015-04-14 09:58:24" touched="2015-04-14 09:58:24" out_of_date="False" xml:space="preserve">Pourquoi ne pas acheter une nouvelle queue avec vos HKC pour vous différencier des autres joueurs en ligne !</text>
        <subtitles />
      </translation>
      <translation id="2962" lang="it">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="itaQA1" date="2015-04-14 10:10:06" />
        </flags>
        <text modified="2015-04-14 10:09:16" textChanged="2015-04-13 15:11:16" updated="2015-04-14 10:09:16" touched="2015-04-14 10:09:16" out_of_date="False" xml:space="preserve">Che ne dici di acquistare una nuova stecca con i tuoi HKC per distinguerti dalla massa online?</text>
        <subtitles />
      </translation>
      <translation id="2962" lang="nl">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="dutQA1" date="2015-04-14 10:02:44" />
        </flags>
        <text modified="2015-04-14 10:02:42" textChanged="2015-04-13 15:10:07" updated="2015-04-14 10:02:42" touched="2015-04-14 10:02:42" out_of_date="False" xml:space="preserve">Gebruik je HKC om een nieuwe keu te kopen, zodat je opvalt online!</text>
        <subtitles />
      </translation>
      <translation id="2962" lang="no">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="norQA1" date="2015-04-14 10:03:04" />
        </flags>
        <text modified="2015-04-14 10:03:02" textChanged="2015-04-13 15:11:32" updated="2015-04-14 10:03:02" touched="2015-04-14 10:03:02" out_of_date="False" xml:space="preserve">Kanskje du skal bruke litt HKC på å kjøpe deg en ny kø, slik at du skiller deg ut fra onlinemengden?</text>
        <subtitles />
      </translation>
      <translation id="2962" lang="po">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="polQA1" date="2015-04-14 10:25:39" />
        </flags>
        <text modified="2015-04-14 10:25:37" textChanged="2015-04-13 15:11:45" updated="2015-04-14 10:25:37" touched="2015-04-14 10:25:37" out_of_date="False" xml:space="preserve">Może czas kupić nowy kij za HKC i wyróżnić się z internetowego tłumu?</text>
        <subtitles />
      </translation>
      <translation id="2962" lang="pt">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="porQA2" date="2015-04-14 10:02:58" />
        </flags>
        <text modified="2015-04-14 10:02:55" textChanged="2015-04-13 15:11:54" updated="2015-04-14 10:02:55" touched="2015-04-14 10:02:55" out_of_date="False" xml:space="preserve">E que tal gastar alguns HKC num taco novo, para te destacares do pessoal online?</text>
        <subtitles />
      </translation>
      <translation id="2962" lang="ru">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="rusQA1" date="2015-04-14 10:06:27" />
        </flags>
        <text modified="2015-04-14 10:06:25" textChanged="2015-04-13 16:07:01" updated="2015-04-14 10:06:25" touched="2015-04-14 10:06:25" out_of_date="False" xml:space="preserve">Почему бы вам не купить новый кий за HKC? Это поможет выделиться в толпе сетевых игроков!</text>
        <subtitles />
      </translation>
      <translation id="2962" lang="sv">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="sweQA1" date="2015-04-14 10:07:04" />
        </flags>
        <text modified="2015-04-14 10:07:02" textChanged="2015-04-13 15:12:11" updated="2015-04-14 10:07:02" touched="2015-04-14 10:07:02" out_of_date="False" xml:space="preserve">Varför inte köpa en ny kö med dina HKC för att stå ut från mängden online?</text>
        <subtitles />
      </translation>
      <translation id="2962" lang="bpt">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="braQA1" date="2015-04-14 10:14:56" />
        </flags>
        <text modified="2015-04-14 10:14:54" textChanged="2015-04-13 15:09:49" updated="2015-04-14 10:14:54" touched="2015-04-14 10:14:54" out_of_date="False" xml:space="preserve">Por que não comprar um novo taco com seu CHK para ajudar a se destacar na multidão online?</text>
        <subtitles />
      </translation>
      <translation id="2962" lang="las">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="mexQA1" date="2015-04-14 12:01:53" />
        </flags>
        <text modified="2015-04-14 12:01:24" textChanged="2015-04-13 15:11:25" updated="2015-04-14 12:01:24" touched="2015-04-14 12:01:53" out_of_date="False" xml:space="preserve">Si lo que quieres es destacar en la comunidad online, puedes comprar un taco nuevo con tus CHK.</text>
        <subtitles />
      </translation>
    </translations>
    <data />
  </message>
  <message type="BGCycling" repeatCnt="1">
    <source id="2963" unique_name="Chalks can give you an advantage when playing against a tricky opponent or when you need to guarantee a pot." is_remote_fed="false" seq="33" should_be_translated="True" is_redundant="false">
      <text modified="2015-04-09 10:38:57" xml:space="preserve">Chalks can give you an advantage against a tricky opponent and help you clear the hardest daily challenges.</text>
      <flags />
    </source>
    <links />
    <translations>
      <translation id="2963" lang="ae">
        <flags />
        <text modified="2015-04-13 17:17:40" textChanged="2015-04-13 17:17:40" updated="2015-04-13 17:17:40" touched="2015-04-13 17:17:40" out_of_date="False" xml:space="preserve">Chalks can give you an advantage against a tricky opponent and help you clear the hardest daily challenges.</text>
        <subtitles />
      </translation>
      <translation id="2963" lang="da">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="danQA1" date="2015-04-14 10:24:42" />
        </flags>
        <text modified="2015-04-10 12:34:11" textChanged="2015-04-13 15:09:59" updated="2015-04-13 15:09:59" touched="2015-04-13 15:09:59" out_of_date="False" xml:space="preserve">Kridt kan give dig en fordel mod en besværlig modstander og hjælpe dig med de sværeste daglige udfordringer.</text>
        <subtitles />
      </translation>
      <translation id="2963" lang="de">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="gerQA2" date="2015-04-14 10:28:08" />
        </flags>
        <text modified="2015-04-10 12:34:12" textChanged="2015-04-13 15:10:16" updated="2015-04-13 15:10:16" touched="2015-04-13 15:10:16" out_of_date="False" xml:space="preserve">Kreiden verschaffen Ihnen bei schwierigen Gegnern einen Vorteil und helfen Ihnen, auch die schwierigsten Tagesherausforderungen zu meistern.</text>
        <subtitles />
      </translation>
      <translation id="2963" lang="en">
        <flags />
        <text modified="2015-04-09 10:38:57" textChanged="2015-04-09 10:38:57" updated="2015-04-09 10:38:57" touched="2015-04-09 10:38:57" out_of_date="False" xml:space="preserve">Chalks can give you an advantage against a tricky opponent and help you clear the hardest daily challenges.</text>
        <subtitles />
      </translation>
      <translation id="2963" lang="es">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="spaQA1" date="2015-04-14 10:08:53" />
        </flags>
        <text modified="2015-04-10 12:34:15" textChanged="2015-04-13 15:12:02" updated="2015-04-13 15:12:02" touched="2015-04-13 15:12:02" out_of_date="False" xml:space="preserve">Las tizas pueden darte ventaja contra un oponente complicado y ayudarte a superar los desafíos diarios más difíciles.</text>
        <subtitles />
      </translation>
      <translation id="2963" lang="fi">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="finQA1" date="2015-04-14 10:18:21" />
        </flags>
        <text modified="2015-04-10 12:34:11" textChanged="2015-04-13 15:10:24" updated="2015-04-13 15:10:24" touched="2015-04-13 15:10:24" out_of_date="False" xml:space="preserve">Liidut voivat antaa etua kohdatessasi vaikean vastustajan ja auttaa vaikeimpien päivähaasteiden selvittämisessä.</text>
        <subtitles />
      </translation>
      <translation id="2963" lang="fr">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="freQA1" date="2015-04-14 11:42:48" />
        </flags>
        <text modified="2015-04-10 12:34:12" textChanged="2015-04-13 15:11:07" updated="2015-04-13 15:11:07" touched="2015-04-13 15:11:07" out_of_date="False" xml:space="preserve">Les craies peuvent vous donner l'avantage contre un adversaire difficile et vous aider à accomplir les défis quotidiens les plus ardus.</text>
        <subtitles />
      </translation>
      <translation id="2963" lang="it">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="itaQA1" date="2015-04-14 10:10:16" />
        </flags>
        <text modified="2015-04-10 12:34:12" textChanged="2015-04-13 15:11:16" updated="2015-04-13 15:11:16" touched="2015-04-13 15:11:16" out_of_date="False" xml:space="preserve">I gessi possono assegnarti un vantaggio contro un avversario impegnativo e aiutarti a completare le sfide giornaliere più difficili.</text>
        <subtitles />
      </translation>
      <translation id="2963" lang="nl">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="dutQA1" date="2015-04-14 10:02:54" />
        </flags>
        <text modified="2015-04-10 12:34:11" textChanged="2015-04-13 15:10:07" updated="2015-04-13 15:10:07" touched="2015-04-13 15:10:07" out_of_date="False" xml:space="preserve">Krijtjes kunnen je helpen tegen lastige tegenstanders en met de moeilijkste dagelijkse uitdagingen.</text>
        <subtitles />
      </translation>
      <translation id="2963" lang="no">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="norQA1" date="2015-04-14 10:03:38" />
        </flags>
        <text modified="2015-04-10 12:34:13" textChanged="2015-04-13 15:11:32" updated="2015-04-13 15:11:32" touched="2015-04-13 15:11:32" out_of_date="False" xml:space="preserve">Med kritt kan du få overtaket mot vriene motstandere og klare de mest krevende daglige utfordringene.</text>
        <subtitles />
      </translation>
      <translation id="2963" lang="po">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="polQA1" date="2015-04-14 10:25:47" />
        </flags>
        <text modified="2015-04-14 10:25:43" textChanged="2015-04-13 15:11:45" updated="2015-04-14 10:25:43" touched="2015-04-14 10:25:43" out_of_date="False" xml:space="preserve">Kreda daje ci przewagę nad zręcznym przeciwnikiem i pozwala ci zaliczyć najtrudniejsze wyzwania dnia.</text>
        <subtitles />
      </translation>
      <translation id="2963" lang="pt">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="porQA2" date="2015-04-14 10:05:44" />
        </flags>
        <text modified="2015-04-14 10:05:41" textChanged="2015-04-14 10:05:41" updated="2015-04-14 10:05:41" touched="2015-04-14 10:05:41" out_of_date="False" xml:space="preserve">Os gizes podem colocar-te em vantagem ao defrontares um adversário complicado e facilitar a conclusão dos desafios diários mais difíceis.</text>
        <subtitles />
      </translation>
      <translation id="2963" lang="ru">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="rusQA1" date="2015-04-14 10:06:40" />
        </flags>
        <text modified="2015-04-10 12:34:15" textChanged="2015-04-13 16:07:01" updated="2015-04-13 16:07:01" touched="2015-04-13 16:07:01" out_of_date="False" xml:space="preserve">Мел поможет вам справиться со сложным противником и выполнить самые трудные ежедневные задания.</text>
        <subtitles />
      </translation>
      <translation id="2963" lang="sv">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="sweQA1" date="2015-04-14 10:06:49" />
        </flags>
        <text modified="2015-04-10 12:34:15" textChanged="2015-04-13 15:12:11" updated="2015-04-13 15:12:11" touched="2015-04-13 15:12:11" out_of_date="False" xml:space="preserve">Kritor kan ge dig övertag mot en svår motståndare och hjälpa dig klara de svåraste dagliga utmaningarna.</text>
        <subtitles />
      </translation>
      <translation id="2963" lang="bpt">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="braQA1" date="2015-04-14 10:15:42" />
        </flags>
        <text modified="2015-04-10 12:34:10" textChanged="2015-04-13 15:09:49" updated="2015-04-13 15:09:49" touched="2015-04-13 15:09:49" out_of_date="False" xml:space="preserve">Giz ajuda a dar vantagem contra um oponente difícil e a realizar os desafios diários mais difíceis.</text>
        <subtitles />
      </translation>
      <translation id="2963" lang="las">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="mexQA1" date="2015-04-14 10:11:15" />
        </flags>
        <text modified="2015-04-10 12:34:13" textChanged="2015-04-13 15:11:25" updated="2015-04-13 15:11:25" touched="2015-04-13 15:11:25" out_of_date="False" xml:space="preserve">Las tizas son muy útiles a la hora de enfrentarte a los contrincantes más duros y resolver los desafíos diarios más difíciles.</text>
        <subtitles />
      </translation>
    </translations>
    <data />
  </message>
  <message type="BGCycling" repeatCnt="1">
    <source id="2965" unique_name="Try out playing with the different ball sets in the career mode." is_remote_fed="false" seq="35" should_be_translated="True" is_redundant="false">
      <text modified="2015-04-09 10:42:44" xml:space="preserve">You can now sample some of the different ball sets in Career mode.  See which ones work for you.</text>
      <flags />
    </source>
    <links />
    <translations>
      <translation id="2965" lang="ae">
        <flags />
        <text modified="2015-04-13 17:18:49" textChanged="2015-04-13 17:18:49" updated="2015-04-13 17:18:49" touched="2015-04-13 17:18:49" out_of_date="False" xml:space="preserve">You can now sample some of the different ball sets in Career mode. See which ones work for you.</text>
        <subtitles />
      </translation>
      <translation id="2965" lang="da">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="danQA1" date="2015-04-14 10:29:56" />
        </flags>
        <text modified="2015-04-10 12:34:11" textChanged="2015-04-13 15:09:59" updated="2015-04-13 15:09:59" touched="2015-04-13 15:09:59" out_of_date="False" xml:space="preserve">Du kan nu samle forskellige sæt baller i karrieredelen. Prøv dig frem og se, hvad du foretrækker.</text>
        <subtitles />
      </translation>
      <translation id="2965" lang="de">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="gerQA2" date="2015-04-14 10:28:29" />
        </flags>
        <text modified="2015-04-10 12:34:12" textChanged="2015-04-13 15:10:16" updated="2015-04-13 15:10:16" touched="2015-04-13 15:10:16" out_of_date="False" xml:space="preserve">Jetzt können Sie einige der verschiedenen Kugelsets testen, die Ihnen im Karrieremodus zur Verfügung stehen. Probieren Sie aus, welche Ihnen liegen.</text>
        <subtitles />
      </translation>
      <translation id="2965" lang="en">
        <flags />
        <text modified="2015-04-09 10:42:44" textChanged="2015-04-09 10:42:44" updated="2015-04-09 10:42:44" touched="2015-04-09 10:42:44" out_of_date="False" xml:space="preserve">You can now sample some of the different ball sets in Career mode.  See which ones work for you.</text>
        <subtitles />
      </translation>
      <translation id="2965" lang="es">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="spaQA1" date="2015-04-14 10:09:19" />
        </flags>
        <text modified="2015-04-10 12:34:15" textChanged="2015-04-13 15:12:02" updated="2015-04-13 15:12:02" touched="2015-04-13 15:12:02" out_of_date="False" xml:space="preserve">Ahora puedes probar algunos de los diferentes conjuntos de bolas en el modo Carrera. Comprueba cuál te funciona mejor.</text>
        <subtitles />
      </translation>
      <translation id="2965" lang="fi">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="finQA1" date="2015-04-14 10:21:20" />
        </flags>
        <text modified="2015-04-10 12:34:11" textChanged="2015-04-13 15:10:24" updated="2015-04-13 15:10:24" touched="2015-04-13 15:10:24" out_of_date="False" xml:space="preserve">Voit nyt kokeilla erilaisia palloja uratilassa. Kokeile ja löydä sinulle sopivat pallot.</text>
        <subtitles />
      </translation>
      <translation id="2965" lang="fr">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="freQA1" date="2015-04-14 10:05:50" />
        </flags>
        <text modified="2015-04-10 12:34:12" textChanged="2015-04-13 15:11:07" updated="2015-04-13 15:11:07" touched="2015-04-13 15:11:07" out_of_date="False" xml:space="preserve">Vous pouvez maintenant essayer les différents ensembles de boules en mode Carrière. Déterminez lequel vous convient le mieux.</text>
        <subtitles />
      </translation>
      <translation id="2965" lang="it">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="itaQA1" date="2015-04-14 10:11:43" />
        </flags>
        <text modified="2015-04-10 12:34:12" textChanged="2015-04-13 15:11:16" updated="2015-04-13 15:11:16" touched="2015-04-13 15:11:16" out_of_date="False" xml:space="preserve">Ora puoi provare alcuni dei vari set di biglie disponibili nella modalità Carriera, per trovare quello che fa al caso tuo.</text>
        <subtitles />
      </translation>
      <translation id="2965" lang="nl">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="dutQA1" date="2015-04-14 10:03:16" />
        </flags>
        <text modified="2015-04-10 12:34:11" textChanged="2015-04-13 15:10:07" updated="2015-04-13 15:10:07" touched="2015-04-13 15:10:07" out_of_date="False" xml:space="preserve">Je kunt nu een aantal ballensets uitproberen in het speltype Carrière. Ontdek welke jou het best liggen.</text>
        <subtitles />
      </translation>
      <translation id="2965" lang="no">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="norQA1" date="2015-04-14 10:08:35" />
        </flags>
        <text modified="2015-04-10 12:34:13" textChanged="2015-04-13 15:11:32" updated="2015-04-13 15:11:32" touched="2015-04-13 15:11:32" out_of_date="False" xml:space="preserve">Nå kan du prøve noen av de ulike ballsettene i karrieremodus, og dermed finne ut hvilke som funker best for deg.</text>
        <subtitles />
      </translation>
      <translation id="2965" lang="po">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="polQA1" date="2015-04-14 10:26:02" />
        </flags>
        <text modified="2015-04-14 10:25:59" textChanged="2015-04-13 15:11:45" updated="2015-04-14 10:25:59" touched="2015-04-14 10:25:59" out_of_date="False" xml:space="preserve">Możesz teraz wypróbować różne zestawy bil w trybie kariery. Sprawdź, który jest odpowiedni dla ciebie.</text>
        <subtitles />
      </translation>
      <translation id="2965" lang="pt">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="porQA2" date="2015-04-14 10:06:09" />
        </flags>
        <text modified="2015-04-10 12:34:14" textChanged="2015-04-13 15:11:54" updated="2015-04-13 15:11:54" touched="2015-04-13 15:11:54" out_of_date="False" xml:space="preserve">Agora podes experimentar alguns dos conjuntos de bolas no modo Carreira para ver qual preferes.</text>
        <subtitles />
      </translation>
      <translation id="2965" lang="ru">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="rusQA1" date="2015-04-14 10:07:32" />
        </flags>
        <text modified="2015-04-10 12:34:15" textChanged="2015-04-13 16:07:01" updated="2015-04-13 16:07:01" touched="2015-04-13 16:07:01" out_of_date="False" xml:space="preserve">Теперь вы можете опробовать разные наборы шаров в режиме карьеры. Смотрите и выбирайте!</text>
        <subtitles />
      </translation>
      <translation id="2965" lang="sv">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="sweQA1" date="2015-04-14 10:05:28" />
        </flags>
        <text modified="2015-04-10 12:34:15" textChanged="2015-04-13 15:12:11" updated="2015-04-13 15:12:11" touched="2015-04-13 15:12:11" out_of_date="False" xml:space="preserve">Nu kan du prova några av de olika bollarna i karriärläget. Se vilka som fungerar för dig.</text>
        <subtitles />
      </translation>
      <translation id="2965" lang="bpt">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="braQA1" date="2015-04-14 10:18:20" />
        </flags>
        <text modified="2015-04-10 12:34:10" textChanged="2015-04-13 15:09:49" updated="2015-04-13 15:09:49" touched="2015-04-13 15:09:49" out_of_date="False" xml:space="preserve">Agora você pode experimentar alguns dos diferentes conjuntos de bola no modo carreira. Veja qual é melhor para você.</text>
        <subtitles />
      </translation>
      <translation id="2965" lang="las">
        <flags>
          <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="mexQA1" date="2015-04-14 10:19:43" />
        </flags>
        <text modified="2015-04-10 12:34:13" textChanged="2015-04-13 15:11:25" updated="2015-04-13 15:11:25" touched="2015-04-13 15:11:25" out_of_date="False" xml:space="preserve">Ahora puedes probar algunos conjuntos de bolas del modo Carrera y ver cuál de ellos se adapta mejor a tus necesidades.</text>
        <subtitles />
      </translation>
    </translations>
    <data />
  </message>
