<Root>
  <Schedule name="Wednesday Event" recurrence="168" recurrenceOffset="24.0" recurrenceDayOfWeek="Tuesday" openTime="18" priority="2">
    <message type="open" repeatCnt="2">
      <source id="2788" unique_name="Weekly Special Event Message" is_remote_fed="false" seq="45" should_be_translated="True" is_redundant="false">
        <text modified="2014-11-27 14:05:17" xml:space="preserve">The League weekly [special high-stake room is available now!][@flash3]</text>
        <flags />
      </source>
      <links />
      <translations>
        <translation id="2788" lang="ae">
          <flags />
          <text modified="2014-11-27 14:05:50" textChanged="2014-11-27 14:05:50" updated="2014-11-27 14:05:50" touched="2014-11-27 14:05:50" out_of_date="False" xml:space="preserve">The League weekly [special high-stake room is available now!][@flash3]</text>
          <subtitles />
        </translation>
        <translation id="2788" lang="da">
          <flags />
          <text modified="2014-11-27 15:17:12" textChanged="2014-11-28 16:35:01" updated="2014-11-28 16:35:01" touched="2014-11-28 16:35:01" out_of_date="False" xml:space="preserve">Ugentlig liga [der er et særligt rum med høje indsatser nu!][@flash3]</text>
          <subtitles />
        </translation>
        <translation id="2788" lang="de">
          <flags />
          <text modified="2014-11-27 15:17:13" textChanged="2014-11-28 16:27:51" updated="2014-11-28 16:27:51" touched="2014-11-28 16:27:51" out_of_date="False" xml:space="preserve">Der wöchentliche [spezielle Liga-Raum mit hohem Einsatz ist jetzt verfügbar!][@flash3]</text>
          <subtitles />
        </translation>
        <translation id="2788" lang="en">
          <flags />
          <text modified="2014-11-27 14:05:17" textChanged="2014-11-27 14:05:17" updated="2014-11-27 14:05:17" touched="2014-11-27 14:05:17" out_of_date="False" xml:space="preserve">The League weekly [special high-stake room is available now!][@flash3]</text>
          <subtitles />
        </translation>
        <translation id="2788" lang="es">
          <flags />
          <text modified="2014-11-27 15:17:16" textChanged="2014-11-28 16:33:59" updated="2014-11-28 16:33:59" touched="2014-11-28 16:33:59" out_of_date="False" xml:space="preserve">[Ya disponible la sala especial de apuestas altas] semanal de la liga [@flash3]</text>
          <subtitles />
        </translation>
        <translation id="2788" lang="fi">
          <flags />
          <text modified="2014-11-27 15:17:12" textChanged="2014-11-28 16:29:26" updated="2014-11-28 16:29:26" touched="2014-11-28 16:29:26" out_of_date="False" xml:space="preserve">Liigan viikoittainen [erityinen korkeiden panosten huone on nyt auki!][@flash3]</text>
          <subtitles />
        </translation>
        <translation id="2788" lang="fr">
          <flags />
          <text modified="2014-11-27 15:17:13" textChanged="2014-11-28 16:30:34" updated="2014-11-28 16:30:34" touched="2014-11-28 16:30:34" out_of_date="False" xml:space="preserve">La ligue hebdomadaire [la salle spéciale est maintenant disponible !][@flash3]</text>
          <subtitles />
        </translation>
        <translation id="2788" lang="it">
          <flags />
          <text modified="2014-11-27 15:17:13" textChanged="2014-11-28 16:30:45" updated="2014-11-28 16:30:45" touched="2014-11-28 16:30:45" out_of_date="False" xml:space="preserve">La [stanza speciale settimanale del campionato con la posta in palio elevata è disponibile ora!][@flash3]</text>
          <subtitles />
        </translation>
        <translation id="2788" lang="nl">
          <flags />
          <text modified="2014-11-27 15:17:12" textChanged="2014-11-28 16:36:40" updated="2014-11-28 16:36:40" touched="2014-11-28 16:36:40" out_of_date="False" xml:space="preserve">De wekelijkse [risico-gameroom van de competitie is nu beschikbaar!][@flash3]</text>
          <subtitles />
        </translation>
        <translation id="2788" lang="no">
          <flags>
            <flag edit="false" name="Translation Comment" type="text" icon="flag_blue.png" dirty="False" active="true" user="KWang" date="2014-10-30 11:08:43" xml:space="preserve">Placeholder?</flag>
          </flags>
          <text modified="2014-11-27 15:17:14" textChanged="2014-11-28 16:31:36" updated="2014-11-28 16:31:36" touched="2014-11-28 16:31:36" out_of_date="False" xml:space="preserve">Ligaens ukentlige [spesialrom med høy innsats er tilgjengelig][@flash3].</text>
          <subtitles />
        </translation>
        <translation id="2788" lang="po">
          <flags />
          <text modified="2014-11-27 15:17:14" textChanged="2014-11-28 16:35:39" updated="2014-11-28 16:35:39" touched="2014-11-28 16:35:39" out_of_date="False" xml:space="preserve">Cotygodniowa, ligowa, [specjalna sala wysokich stawek jest już dostępna!][@flash3].</text>
          <subtitles />
        </translation>
        <translation id="2788" lang="pt">
          <flags />
          <text modified="2014-11-27 15:17:15" textChanged="2014-11-28 16:36:31" updated="2014-11-28 16:36:31" touched="2014-11-28 16:36:31" out_of_date="False" xml:space="preserve">[A sala especial de grandes apostas][@flash3] semanal da Liga já está disponível!</text>
          <subtitles />
        </translation>
        <translation id="2788" lang="ru">
          <flags>
            <flag edit="false" name="Reviewed in LAMS" type="checkbox" icon="reviewed\InLamsYes.png" dirty="False" active="true" user="rusQA2" date="2014-12-02 10:22:35" />
          </flags>
          <text modified="2014-12-02 10:22:33" textChanged="2014-12-01 14:44:31" updated="2014-12-02 10:22:33" touched="2014-12-02 10:22:33" out_of_date="False" xml:space="preserve">Лиговая еженедельная [специальная комната с большими ставками доступна!][@flash3]</text>
          <subtitles />
        </translation>
        <translation id="2788" lang="sv">
          <flags />
          <text modified="2014-11-27 15:17:16" textChanged="2014-11-28 16:34:09" updated="2014-11-28 16:34:09" touched="2014-11-28 16:34:09" out_of_date="False" xml:space="preserve">Veckans [höginsatsrum i ligan är tillgängligt nu!][@flash3]</text>
          <subtitles />
        </translation>
        <translation id="2788" lang="bpt">
          <flags />
          <text modified="2014-11-27 15:17:11" textChanged="2014-11-28 16:33:38" updated="2014-11-28 16:33:38" touched="2014-11-28 16:33:38" out_of_date="False" xml:space="preserve">A Liga semanal [sala especial de alto risco já está disponível!][@flash3]</text>
          <subtitles />
        </translation>
        <translation id="2788" lang="las">
          <flags />
          <text modified="2014-11-27 15:17:14" textChanged="2014-11-28 16:30:54" updated="2014-11-28 16:30:54" touched="2014-11-28 16:30:54" out_of_date="False" xml:space="preserve">Liga semanal [¡Sala especial de alto riesgo ya disponible!][@flash3]</text>
          <subtitles />
        </translation>
      </translations>
      <data />
    </message>
    <message type="close" repeatCnt="2">
      <source id="2875" unique_name="Special Event Closed Message" is_remote_fed="false" seq="66" should_be_translated="True" is_redundant="false">
        <text modified="2014-11-27 14:07:26" xml:space="preserve">The League special high-stake room is now closed.</text>
        <flags />
      </source>
      <links />
      <translations>
        <translation id="2875" lang="ae">
          <flags />
          <text modified="2014-11-27 14:41:34" textChanged="2014-11-27 14:41:34" updated="2014-11-27 14:41:34" touched="2014-11-27 14:41:34" out_of_date="False" xml:space="preserve">The League special high-stake room is now closed.</text>
          <subtitles />
        </translation>
        <translation id="2875" lang="da">
          <flags />
          <text modified="2014-11-27 15:17:12" textChanged="2014-11-28 16:35:01" updated="2014-11-28 16:35:01" touched="2014-11-28 16:35:01" out_of_date="False" xml:space="preserve">Ligaens særlige rum med høje indsatser er nu lukket.</text>
          <subtitles />
        </translation>
        <translation id="2875" lang="de">
          <flags />
          <text modified="2014-11-27 15:17:13" textChanged="2014-11-28 16:27:51" updated="2014-11-28 16:27:51" touched="2014-11-28 16:27:51" out_of_date="False" xml:space="preserve">Der spezielle Liga-Raum mit hohem Einsatz ist jetzt geschlossen.</text>
          <subtitles />
        </translation>
        <translation id="2875" lang="en">
          <flags />
          <text modified="2014-11-27 14:07:27" textChanged="2014-11-27 14:07:27" updated="2014-11-27 14:07:27" touched="2014-11-27 14:07:27" out_of_date="False" xml:space="preserve">The League special high-stake room is now closed.</text>
          <subtitles />
        </translation>
        <translation id="2875" lang="es">
          <flags />
          <text modified="2014-11-27 15:17:16" textChanged="2014-11-28 16:33:59" updated="2014-11-28 16:33:59" touched="2014-11-28 16:33:59" out_of_date="False" xml:space="preserve">La sala especial de apuestas altas de la liga está cerrada.</text>
          <subtitles />
        </translation>
        <translation id="2875" lang="fi">
          <flags />
          <text modified="2014-11-27 15:17:12" textChanged="2014-11-28 16:29:26" updated="2014-11-28 16:29:26" touched="2014-11-28 16:29:26" out_of_date="False" xml:space="preserve">Liigan erityinen korkeiden panosten huone on nyt suljettu.</text>
          <subtitles />
        </translation>
        <translation id="2875" lang="fr">
          <flags />
          <text modified="2014-11-27 15:17:13" textChanged="2014-11-28 16:30:34" updated="2014-11-28 16:30:34" touched="2014-11-28 16:30:34" out_of_date="False" xml:space="preserve">La salle spéciale de la ligue est maintenant fermée.</text>
          <subtitles />
        </translation>
        <translation id="2875" lang="it">
          <flags />
          <text modified="2014-11-27 15:17:13" textChanged="2014-11-28 16:30:45" updated="2014-11-28 16:30:45" touched="2014-11-28 16:30:45" out_of_date="False" xml:space="preserve">La stanza speciale del campionato con la posta in palio elevata al momento è chiusa.</text>
          <subtitles />
        </translation>
        <translation id="2875" lang="nl">
          <flags />
          <text modified="2014-11-27 15:17:12" textChanged="2014-11-28 16:36:40" updated="2014-11-28 16:36:40" touched="2014-11-28 16:36:40" out_of_date="False" xml:space="preserve">De risico-gameroom van de competitie is nu gesloten.</text>
          <subtitles />
        </translation>
        <translation id="2875" lang="no">
          <flags />
          <text modified="2014-11-27 15:17:14" textChanged="2014-11-28 16:31:36" updated="2014-11-28 16:31:36" touched="2014-11-28 16:31:36" out_of_date="False" xml:space="preserve">Rommet til spesialligaen for høy innsats er nå stengt.</text>
          <subtitles />
        </translation>
        <translation id="2875" lang="po">
          <flags />
          <text modified="2014-11-27 15:17:14" textChanged="2014-11-28 16:35:39" updated="2014-11-28 16:35:39" touched="2014-11-28 16:35:39" out_of_date="False" xml:space="preserve">Ligowa, specjalna sala wysokich stawek jest teraz zamknięta.</text>
          <subtitles />
        </translation>
        <translation id="2875" lang="pt">
          <flags />
          <text modified="2014-11-27 15:17:15" textChanged="2014-11-28 16:36:31" updated="2014-11-28 16:36:31" touched="2014-11-28 16:36:31" out_of_date="False" xml:space="preserve">A sala especial de grandes apostas da Liga está encerrada.</text>
          <subtitles />
        </translation>
        <translation id="2875" lang="ru">
          <flags />
          <text modified="2014-11-27 15:17:15" textChanged="2014-12-01 14:44:32" updated="2014-12-01 14:44:32" touched="2014-12-01 14:44:32" out_of_date="False" xml:space="preserve">Лиговая специальная комната с большими ставками закрыта.</text>
          <subtitles />
        </translation>
        <translation id="2875" lang="sv">
          <flags />
          <text modified="2014-11-27 15:17:16" textChanged="2014-11-28 16:34:09" updated="2014-11-28 16:34:09" touched="2014-11-28 16:34:09" out_of_date="False" xml:space="preserve">Ligans höginsatsrum är nu stängt.</text>
          <subtitles />
        </translation>
        <translation id="2875" lang="bpt">
          <flags />
          <text modified="2014-11-27 15:17:11" textChanged="2014-11-28 16:33:38" updated="2014-11-28 16:33:38" touched="2014-11-28 16:33:38" out_of_date="False" xml:space="preserve">A sala especial de alto risco da liga está fechada.</text>
          <subtitles />
        </translation>
        <translation id="2875" lang="las">
          <flags />
          <text modified="2014-11-27 15:17:14" textChanged="2014-11-28 16:30:54" updated="2014-11-28 16:30:54" touched="2014-11-28 16:30:54" out_of_date="False" xml:space="preserve">La sala especial de alto riesgo de la liga está cerrada.</text>
          <subtitles />
        </translation>
      </translations>
      <data />
    </message>
