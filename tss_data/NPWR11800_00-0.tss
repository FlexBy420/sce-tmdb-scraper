	<SETS>
		<SET name="Nothing"/>
		<SET name="Burning"		chargeMultiplier="3.34"	chargeBonusMultiplierPerMatchingNeighbour="0.6"	use="Burn_Use"		verb="Burn_Verb"	icon="abilityIconBurn"/>
		<SET name="Frozen"		chargeMultiplier="2.5"	chargeBonusMultiplierPerMatchingNeighbour="0.5"	use="Frozen_Use"	verb="Frozen_Verb"	icon="abilityIconFreeze"/>
		<SET name="Plasma"		chargeMultiplier="2.5"	chargeBonusMultiplierPerMatchingNeighbour="0.5"	use="Plasma_Use"	verb="Plasma_Verb"	icon="abilityIconPlasma"/>
		<SET name="Life"		chargeMultiplier="0.3"	chargeBonusMultiplierPerMatchingNeighbour="0.1"	use="Life_Use"		verb="Life_Verb"/>
		<SET name="Spectral"	chargeMultiplier="1.0"	chargeBonusMultiplierPerMatchingNeighbour="0.2"	use="Spectral_Use"	verb="Spectral_Verb"/>
		<SET name="Filth"		chargeMultiplier="1.0"	chargeBonusMultiplierPerMatchingNeighbour="0.2"	use="Filth_Use"		verb="Filth_Verb"/>
	</SETS>

