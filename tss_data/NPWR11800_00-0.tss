			<TRIGGER text="Card to Left"/>
			<TRIGGER text="Card to Right"/>
			<TRIGGER text="Card Above"/>
			<TRIGGER text="Card Below"/>
			<TRIGGER text="Only One"/>
			<TRIGGER text="Charges Fast"/>
			<TRIGGER text="Card Above or Below"/>
			<TRIGGER text="Card Left and Right"/>
